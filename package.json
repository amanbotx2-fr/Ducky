{
  "name": "ducky-desktop-companion",
  "productName": "Ducky",
  "version": "2.0.0",
  "private": true,
  "description": "Ducky desktop AI companion.",
  "author": "Aman",
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",
    "dev:renderer": "vite",
    "typecheck": "tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "clean": "rimraf dist",
    "clean:artifacts": "rimraf release",
    "build:test-support": "tsc -p tsconfig.test.json",
    "build:renderer": "vite build",
    "build": "npm run clean && npm run typecheck && npm run build:renderer",
    "test": "npm run build:test-support && node --test tests/*.test.cjs",
    "dist": "npm run tauri:build",
    "release:validate-versions": "node scripts/release/validate-versions.mjs",
    "release:verify-bundle": "node scripts/release/verify-release-bundle.mjs",
    "release:verify-signatures": "node scripts/release/verify-updater-signatures.mjs",
    "start": "tauri dev",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  }
}
