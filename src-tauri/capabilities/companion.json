{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "companion",
  "description": "Least-privilege capability for the companion window.",
  "local": true,
  "webviews": ["companion"],
  "permissions": [
    "allow-get-cursor-position",
    "allow-get-runtime-settings",
    "allow-get-companion-window-position",
    "allow-move-companion-window",
    "allow-set-companion-content-height",
    "allow-show-companion-context-menu",
    "allow-stream-cursor-positions",
    "allow-stop-cursor-positions",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
